import {
  "q0w1ertyuiop/senweave/integrations/coap" @collector,
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/string",
  "q0w1ertyuiop/senweave",
}

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "new_collector",
        "new_deferred_collector",
        "receive",
        "poll",
        "finish",
        "complete",
        "new_sender",
        "sender_start",
        "sender_receive",
        "sender_poll",
        "sender_cancel",
        "sender_deadline",
      ],
      "format": "cjs",
    },
  },
)
